{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PublicWebsiteRead",
      "Effect": "Allow",
      "Principal": "*",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::novashop-site/*"
    },
    {
      "Sid": "HideBucketListing",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::novashop-site"
    }
  ]
}
